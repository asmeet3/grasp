# ============================================================
# GRASP environment template
# Copy this file to `.env` and fill in your real values.
# ============================================================

# ------------------------------------------------------------
# LLM_PROVIDER=(deepseek/anthropic)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-api03
AGENT_MODEL=claude-haiku-4-5-20251001
CLASSIFIER_MODEL=claude-haiku-4-5-20251001
QUERY_SHORTENER_MODEL=claude-haiku-4-5-20251001

#DEEPSEEK_API_KEY=sk-4f3
#AGENT_MODEL=deepseek-v4-flash
#CLASSIFIER_MODEL=deepseek-v4-flash
#QUERY_SHORTENER_MODEL=deepseek-v4-flash

# ------------------------------------------------------------
# OpenAI (embeddings)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-large

# ------------------------------------------------------------
# Knowledge repository
# ------------------------------------------------------------
GITHUB_REPO_PATH=./knowledge_repo
GITHUB_REMOTE_URL=https://github.com/your-org/your-knowledge-repo.git
GITHUB_PAT=ghp_...

# ------------------------------------------------------------
# Confluence
# ------------------------------------------------------------
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_EMAIL=your-email@company.com
CONFLUENCE_API_TOKEN=your-confluence-api-token

# ------------------------------------------------------------
# Jira
# ------------------------------------------------------------
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@company.com
JIRA_API_TOKEN=your-jira-api-token

# ------------------------------------------------------------
# SharePoint (Microsoft Graph)
# ------------------------------------------------------------
SHAREPOINT_TENANT_ID=your-azure-tenant-id
SHAREPOINT_CLIENT_ID=your-azure-app-client-id
SHAREPOINT_CLIENT_SECRET=your-azure-app-client-secret
SHAREPOINT_SITE_ID=your-tenant.sharepoint.com,site-guid,web-guid

# ------------------------------------------------------------
# Slack
# ------------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...

# ------------------------------------------------------------
# Notion
# ------------------------------------------------------------
NOTION_API_KEY=ntn_...

# ------------------------------------------------------------
# Sync schedule (hours are UTC)
# ------------------------------------------------------------
SYNC_CRON_HOURS=[2,5,8,11,14]
SYNC_CRON_MINUTE=30
SYNC_BATCH_SIZE=100

# ------------------------------------------------------------
# Server
# ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ADMIN_KEY=your-secret-admin-key

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
# Google OAuth 2.0 Client ID (leave empty to disable Google sign-in)
GOOGLE_CLIENT_ID=
# Secret for signing session tokens (falls back to ADMIN_KEY if not set)
SESSION_SECRET=
# 12 hours lived access sessions
ACCESS_TOKEN_MAX_AGE_SECONDS=43200
# JSON list of exact browser origins allowed by CORS
TRUSTED_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]
# Rate limits (requests per minute)
AUTH_RATE_LIMIT_PER_MINUTE=20
QUERY_RATE_LIMIT_PER_MINUTE=60
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# ------------------------------------------------------------
# Uploads
# ------------------------------------------------------------
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PAGES=200
UPLOAD_MAX_TEXT_CHARS=2000000

# ------------------------------------------------------------
# Feature / rollout flags
# Agents and self-improvement require AUTH_REQUIRED=true and
# REVISIONED_KNOWLEDGE=true.
# ------------------------------------------------------------
AUTH_REQUIRED=true
REVISIONED_KNOWLEDGE=true
CONTEXT_ROUTING=false
STRUCTURED_MEMORY=true
PROVIDER_ROUTING=false
AGENTS_ENABLED=true
SELF_IMPROVEMENT_ENABLED=false
# Max tokens of conversation context fed to agents
CONTEXT_TOKEN_BUDGET=8000
# Max providers considered for context routing
MAX_LIVE_PROVIDERS=2
# Overlap (seconds) between sync windows
SYNC_OVERLAP_SECONDS=300
# Worker loop polling interval (seconds)
WORKER_POLL_SECONDS=1.0
WORKER_CONCURRENCY=4
# Seconds between persisted observability snapshots
# (session history survives restarts)
OBSERVABILITY_FLUSH_SECONDS=300

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://grasp:grasp@localhost:5432/grasp
